# Datasets and model outputs — these are large and project-specific; store externally
datasets/
outputs/

# Agent orchestration state — ephemeral, session-specific
.agent-state/

# Isaac Lab USD binary assets — not versioned, download via script in assets/usd/README.md
*.usd
*.usda

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Editor artifacts
.idea/
.vscode/
*.swp
*.swo
*~

# OS junk
.DS_Store
Thumbs.db

# pixi environment
.pixi/

# Autoresearch run outputs
packages/lerobot-isaac-autoresearch/results/
packages/*/.git/

# Local-only orchestration scratch
.local/
scratch/
*.bak
*.orig

# Removed monorepo history copies of spun-out packages — siblings now live in their
# own public GitHub repos (github.com/kvgork/<name>). Any local leftovers under
# archive/ are git-ignored build/env artifacts and must not be re-added.
/archive/

# Editable-siblings dev clones (Phase B opt-in workflow).
# Each entry under src/<pkg>/ is an independent git clone of a spinout bare repo;
# they are NOT part of this repo. The src/ directory itself stays tracked
# (anchored by src/.gitkeep) so `pixi run sync` always has a target to write into.
/src/*/
logs/runs/
logs/
