# .env.example — copy to .env and edit values to override workspace defaults.
#
# scripts/setup_env.sh loads .env (if present) BEFORE applying defaults, so
# anything you set here wins. Lines starting with `#` are comments.
#
# All paths must be absolute. ${HOME} is expanded.

# --- workspace root ---------------------------------------------------------
# Auto-detected from scripts/setup_env.sh location; override only when running
# scripts from outside the workspace (e.g. CI containers, batch jobs).
#LEROBOT_ISAAC_WORKSPACE=${HOME}/workspaces/lerobot-isaac-training

# --- spinouts (bare-repo parent + URL base) ---------------------------------
# SPINOUTS_ROOT holds the 6 sibling bare repos:
#   ${SPINOUTS_ROOT}/lerobot-isaac-configs
#   ${SPINOUTS_ROOT}/lerobot-isaac-dashboard
#   ${SPINOUTS_ROOT}/lerobot-isaac-autoresearch
#   ${SPINOUTS_ROOT}/lerobot-isaac-env
#   ${SPINOUTS_ROOT}/lerobot-isaac-adapters
#   ${SPINOUTS_ROOT}/lerobot-isaac-synthetic
# robot_data_recorder lives alongside (opt-in via `pixi run sync-recorder`).
#SPINOUTS_ROOT=${HOME}/workspaces/spinouts

# LEROBOT_SPINOUTS_BASE is the URL prefix used by pixi.toml + sync scripts.
# Defaults to file://${SPINOUTS_ROOT}. Set to https://github.com/<org> to install
# from GitHub instead (once the spinouts are published).
#LEROBOT_SPINOUTS_BASE=file://${HOME}/workspaces/spinouts
#LEROBOT_SPINOUTS_BASE=https://github.com/<your-github-user>

# --- claude_code repo (agents + skills source of truth) ---------------------
# Required for agent file references; auto-detected at ~/tools/claude_code or
# as a sibling of this workspace.
#CLAUDE_CODE_ROOT=${HOME}/tools/claude_code

# --- vault root (optional) --------------------------------------------------
# Obsidian Second Brain vault. Only needed for /second-brain and /sb-* commands.
#VAULT_ROOT=${HOME}/Documents/Vaults/Local
